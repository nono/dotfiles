[user]
	name = Bruno Michel
	email = bmichel@templatesys.com
[github]
	user = nono
[init]
	defaultBranch = main
[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
[alias]
	ci = commit
	co = checkout
	staged = diff --cached
	unstage = reset HEAD --
	ignored = ls-files --others
	last = log -1 HEAD
	wdiff = diff --color-words
	info = remote -v
	default-branch = "!sh -c 'git symbolic-ref refs/remotes/origin/HEAD | cut -f4 -d/'"
	cleanup = "!sh -c 'git branch --merged | grep -v $(git default-branch) | xargs git branch -D'"
	setup = "!sh -c 'git init && git ci --allow-empty -m \"Initial commit\"'"
	amend = commit --amend --reuse-message=HEAD
	serve = daemon --reuseaddr --verbose  --base-path=. --export-all ./.git
	wa = worktree add
	wr = worktree remove
	wl = worktree list
[help]
	autocorrect = prompt
[diff]
	renames = true
	noprefix = true
	algorithm = histogram
[branch]
	autosetupmerge = true
	autosetuprebase = always
	sort = -committerdate
[column]
	ui = auto
[log]
	date = iso
[tag]
	sort = version:refname
[fetch]
	prune = true
	pruneTags = true
	all = true
[pull]
	rebase = true
[push]
	default = current
	autosetupremote = true
	followTags = true
[rebase]
	autostash = true
	autosquash = true
[rerere]
	enabled = 1
[diff "exif"]
	textconv = exiftool
[core]
	excludesfile = /home/nono/.gitignore
[grep]
	extendRegexp = true
